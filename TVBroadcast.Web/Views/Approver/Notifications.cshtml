@model List<TVBroadcast.Domain.Models.ShowsModel>

@{
    ViewData["Title"] = "Notifications";
}
@if (TempData["Notification"] != null)
{
    <div class="alert alert-success">@TempData["Notification"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Notifications</title>
    <link rel="stylesheet" href="~/css/forms.css" />
    <link rel="stylesheet" href="~/css/webtable.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: rgba(0,0,0,0.5);
            z-index: 1000;
        }

        .modal-content {
            background: white;
            padding: 20px;
            border-radius: 8px;
            width: 400px;
        }

        .modal input, .modal textarea, .modal select {
            width: 100%;
            margin-bottom: 10px;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f9;
        }

        h2 {
            text-align: center;
            margin: 30px 0;
            color: #333;
        }

        table {
            width: 90%;
            margin: auto;
            border-collapse: collapse;
            background-color: white;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        th, td {
            border: 1px solid #ccc;
            padding: 8px 10px;
            text-align: left;
            font-size: 14px;
        }

        th {
            background-color: #3366cc;
            color: white;
            white-space: nowrap;
        }

        td textarea {
            width: 100%;
            padding: 6px;
            border: 1px solid #ccc;
            border-radius: 4px;
            resize: vertical;
            font-size: 12px;
        }

        .action-buttons {
            display: flex;
            justify-content: space-between;
            margin-top: 6px;
        }

            .action-buttons button {
                width: 48%;
                height: 28px;
                border: none;
                border-radius: 4px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                transition: background-color 0.3s ease, transform 0.2s ease;
            }

                .action-buttons button[value="Approve"] {
                    background-color: #007bff;
                    color: white;
                }

                    .action-buttons button[value="Approve"]:hover {
                        background-color: #0069d9;
                        transform: scale(1.05);
                    }

                .action-buttons button[value="Reject"] {
                    background-color: #dc3545;
                    color: white;
                }

                    .action-buttons button[value="Reject"]:hover {
                        background-color: #c82333;
                        transform: scale(1.05);
                    }

        td:nth-child(1), th:nth-child(1) {
            width: 100px;
        }

        td:nth-child(2), th:nth-child(2) {
            width: 80px;
        }

        td:nth-child(3), th:nth-child(3) {
            width: 120px;
        }

        td:nth-child(4), th:nth-child(4),
        td:nth-child(5), th:nth-child(5) {
            width: 100px;
        }

        td:nth-child(6), th:nth-child(6) {
            width: 150px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>TV Broadcast Scheduler</h1>
        <a href="/Account/Login" class="login-button">Logout</a>
        <a href="/Schedule/Index" class="login-button">Home</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Genre</th>
                <th>Description</th>
                <th>Start</th>
                <th>End</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Genre</td>
                    <td>@item.Description</td>
                    <td>@item.StartTime</td>
                    <td>@item.EndTime</td>
                    <td>
                        <form method="post" asp-action="UpdateApprovalStatus" asp-controller="Approver">
                            <input type="hidden" name="Id" value="@item.Id" />
                            <textarea name="Comment" rows="2" placeholder="Enter your comment..."></textarea>
                            <div class="action-buttons">
                                <button type="submit" name="action" value="Approve">Approve</button>
                                <button type="submit" name="action" value="Reject">Reject</button>
                            </div>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>
